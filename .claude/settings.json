{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent-hooks/pre-write-filename-check.sh",
            "timeout": 10,
            "statusMessage": "Checking filename convention..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent-hooks/post-edit-format-lint.sh",
            "timeout": 30,
            "statusMessage": "Formatting and linting..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent-hooks/post-bash-filename-check.sh",
            "timeout": 10,
            "statusMessage": "Checking new file naming conventions..."
          }
        ]
      }
    ]
  }
}
